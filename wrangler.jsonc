{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psych",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "out",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "vars": { "ORDER_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "psych",
      "database_id": "9510a414-c416-4bdb-9f3f-fcbe25bfd6e0",
      "migrations_dir": "worker/migrations"
    }
  ]
  // AI binding lands with ticket 14; secrets TURNSTILE_SECRET and IP_SALT_SECRET via `wrangler secret put`
}
