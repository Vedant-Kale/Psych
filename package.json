{
  "name": "psych",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.21",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.1",
    "@cloudflare/workers-types": "5.20261124.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "serve": "14.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.167.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true,
    "fsevents": false
  }
}
