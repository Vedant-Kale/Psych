{
  "name": "psych",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-graph.ts && node scripts/build-search-index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run build && npm run test && npm run typecheck && npm run e2e",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.21",
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.9.1",
    "@cloudflare/workers-types": "5.20261124.1",
    "@content-collections/core": "0.15.3",
    "@content-collections/markdown": "0.1.4",
    "@content-collections/next": "0.2.11",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "d3-force-3d": "3.0.6",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "serve": "14.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.167.0"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "fsevents": false,
    "esbuild": true
  }
}
